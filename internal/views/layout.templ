package views

// LayoutData is the header chrome that depends on the current session -
// zero value (as passed by the public login/signup pages) renders a bare
// header with no tenant name, nav links, or logout control.
type LayoutData struct {
	TenantName string
	IsAdmin    bool
}

templ Layout(title string, data LayoutData) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/css/tokens.css"/>
			<link rel="stylesheet" href="/static/css/base.css"/>
			<link rel="stylesheet" href="/static/css/board.css"/>
			<link rel="stylesheet" href="/static/css/forms.css"/>
		</head>
		<body>
			<header class="app-bar">
				<a href="/" class="app-bar__title">Print Shop KDS</a>
				if data.TenantName != "" {
					<div class="app-bar__actions">
						<span class="app-bar__tenant">{ data.TenantName }</span>
						if data.IsAdmin {
							<a href="/admin/new-order" class="app-bar__link">+ New Order</a>
							<a href="/admin/users" class="app-bar__link">Users</a>
						}
						<form method="post" action="/logout" class="app-bar__logout-form">
							<button type="submit" class="app-bar__link-button">Log Out</button>
						</form>
					</div>
				}
			</header>
			{ children... }
			<script src="/static/js/htmx.min.js"></script>
		</body>
	</html>
}
